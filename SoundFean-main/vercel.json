
{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server:app"
    },
    "qobuz": {
      "root": "qobuz-addon",
      "framework": "node"
    }
  },
  "rewrites": [
    {
      "source": "/qobuz/(.*)",
      "destination": {
        "type": "service",
        "service": "qobuz",
        "path": "/api"
      }
    },
    {
      "source": "/api/(.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
